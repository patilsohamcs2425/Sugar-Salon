rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if caller is an authorized Sugar Salon administrator
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'sugarsalon6@gmail.com' ||
        request.auth.token.email.matches('.*admin.*')
      );
    }
    
    // Users Profile Collection
    match /users/{userId} {
      allow read, write: if request.auth != null && (
        request.auth.uid == userId || isAdmin()
      );
    }

    // Reviews Collection Rules
    match /reviews/{reviewId} {
      // Anyone can read reviews to display them on the website
      allow read: if true;
      
      // Anyone can submit a new review, provided it contains required fields & valid rating
      allow create: if request.resource.data.keys().hasAll(['author', 'rating', 'comment'])
                    && request.resource.data.rating >= 1
                    && request.resource.data.rating <= 5;
                    
      // Only authorized administrators can update or delete reviews
      allow update, delete: if isAdmin();
    }
    
    // Appointments Collection Rules
    match /appointments/{appointmentId} {
      // Public can read and submit appointments
      allow read, create: if true;
      // Only authorized administrators can update status or delete
      allow update, delete: if isAdmin();
    }

    // Services Collection Rules
    match /services/{serviceId} {
      // Public can read service catalog
      allow read: if true;
      // Only administrators can add/edit/delete treatments
      allow write: if isAdmin();
    }

    // Inquiries Collection Rules
    match /inquiries/{inquiryId} {
      // Anyone can submit an inquiry
      allow create: if true;
      // Only administrators can inspect or manage inquiries
      allow read, update, delete: if isAdmin();
    }
  }
}
